# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION ONLY. Consumed by the `web` and `migrate` services in
# compose.yml — both need database access and nothing else from this file.
# Copy to `.env.database` on the VPS at 0600. Never committed as
# `.env.database`.
#
# The password here must match .env.postgres's POSTGRES_PASSWORD.
# ─────────────────────────────────────────────────────────────────────────────

DATABASE_URL=postgres://burmy:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/burmy
