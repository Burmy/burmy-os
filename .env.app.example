# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION ONLY. Consumed by the `web` and `migrate` services in
# compose.yml (migrate needs OWNER_EMAIL too — see compose.yml's comment on
# provision-owner.mjs). Never TUNNEL_TOKEN, never restic/B2 credentials — see
# .env.tunnel.example / .env.backup.example for those. Copy to `.env.app` on
# the VPS at 0600. Never committed as `.env.app`.
# ─────────────────────────────────────────────────────────────────────────────

# The ONE allowlisted identity — checked against the verified Cloudflare
# Access JWT claim on every request. Treated as sensitive (a phishing target
# for the one account with access) even though it isn't itself a credential.
OWNER_EMAIL=

# Cloudflare Access JWT verification — see docs/SECURITY.md, "Authentication".
# TEAM_DOMAIN accepts `burmy`, `burmy.cloudflareaccess.com`, or the full URL.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
