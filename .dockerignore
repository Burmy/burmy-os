# Keep the build context small and, more importantly, keep secrets and real
# financial data out of the image entirely.

.git
.github
node_modules
.next
out
dist
coverage
playwright-report
test-results

# Secrets — must never enter an image layer.
.env
.env.*
!.env.example
*.pem
*.key

# Real financial data — must never enter an image layer.
*.csv
*.xlsx
*.xls
*.pdf
*.dump
statements/
exports/
backups/

# Not needed at runtime.
docs
tests
*.md
!CLAUDE.md
.vscode
.idea
