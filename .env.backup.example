# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION ONLY. Read directly by scripts/backup.sh, scripts/maintenance.sh
# and scripts/restore.sh — HOST-LEVEL shell scripts. Never injected into any
# Docker container via compose.yml; `web`/`migrate`/`cloudflared` never see
# any of this. Copy to `.env.backup` on the VPS at 0600. Never committed as
# `.env.backup`.
#
# Deliberately EXCLUDED from the Finance backup itself — a stolen backup must
# not also carry the keys to decrypt it. Lives here plus the password
# manager plus (RESTIC_PASSWORD specifically) a printed offline copy.
# ─────────────────────────────────────────────────────────────────────────────

RESTIC_REPOSITORY=
RESTIC_PASSWORD=
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=

# OPTIONAL — healthchecks.io monitoring is deferred for V1 (owner decision,
# M10 simplification), not part of the required launch path. Leave all four
# blank and scripts/{backup,maintenance,restore-verify-weekly,
# check-host}.sh's ping calls are a genuine no-op, not a degraded mode. If
# ever wanted later: one healthchecks.io check per job (so a missed run is
# attributable to the specific job), base URL only, no trailing slash —
# scripts append /start and /fail themselves. Treated as secrets and stored
# here alongside the backup credentials if populated.
HEALTHCHECKS_BACKUP_PING_URL=
HEALTHCHECKS_MAINTENANCE_PING_URL=
HEALTHCHECKS_RESTORE_VERIFY_PING_URL=
HEALTHCHECKS_CHECK_HOST_PING_URL=
