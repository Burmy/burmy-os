[Unit]
# OPTIONAL — not enabled by scripts/provision.sh. See burmy-restore-verify.service.
Description=Weekly Sunday 05:00 — Burmy automated restore verification (after maintenance) [OPTIONAL]

[Timer]
OnCalendar=Sun *-*-* 05:00:00
RandomizedDelaySec=15m
Persistent=true

[Install]
WantedBy=timers.target
