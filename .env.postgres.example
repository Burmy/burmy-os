# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION ONLY. Consumed exclusively by the `postgres` service in
# compose.yml — nothing else reads this file. Copy to `.env.postgres` on the
# VPS at 0600, owned by the app user. Never committed as `.env.postgres`.
#
# The password set here must be duplicated into `.env.database`'s
# DATABASE_URL (see .env.database.example) — there is no automatic
# derivation between the two files, since both are static and written once
# during initial secret setup.
# ─────────────────────────────────────────────────────────────────────────────

POSTGRES_USER=burmy
POSTGRES_PASSWORD=
POSTGRES_DB=burmy
