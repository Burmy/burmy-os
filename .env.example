# ─────────────────────────────────────────────────────────────────────────────
# Burmy — environment template
#
# PLACEHOLDERS ONLY. Never put a real secret in this file — it is committed.
# Copy to `.env` for local development. `.env` is gitignored and must stay so.
#
# On the VPS, `.env` lives at mode 0600 owned by the app user and is injected
# via `env_file`. Real values are held in the password manager and are
# deliberately NOT included in Finance backups — a stolen backup must not also
# carry the keys to the system it came from.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# Local development, matching compose.dev.yml.
# In production the host is the internal `dbnet` service name, never localhost.
DATABASE_URL=postgres://burmy:burmy@localhost:5432/burmy

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development

# The ONE allowlisted identity. Checked against the verified Cloudflare Access
# JWT claim and again at session creation. There is no signup route.
OWNER_EMAIL=you@example.com

# ── Authentication ───────────────────────────────────────────────────────────
# Better Auth handles PASSKEYS and the local session only.
# Google is configured exactly ONCE, in Cloudflare Access — not here.
#
# BETTER_AUTH_SECRET signs the session cookie. It is REQUIRED in production:
# without it Better Auth silently falls back to a built-in default secret, which
# would mean anyone could forge a session cookie. The app refuses to start in
# production rather than do that. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=generate-a-random-32-byte-value

# Also sets the WebAuthn rpID (its hostname). localhost is a secure context, so
# passkeys work in development without TLS. Production is https://app.burmy.me.
BETTER_AUTH_URL=http://localhost:3000

# ── Cloudflare Access — FACTOR 1 ─────────────────────────────────────────────
# Verified against Cloudflare's JWKS in src/proxy.ts AND again inside
# requireOwner(), so a route the proxy matcher misses still enforces both
# factors.
#
# FAIL CLOSED: these are REQUIRED unless NODE_ENV is exactly `development`.
# Anything else — production, test, staging, or unset — with these missing makes
# the app refuse every request with 503 rather than serve traffic without the
# outer gate. A missing config is an outage; a skipped check is a breach.
#
# Left blank locally, where verification is bypassed by design (no Cloudflare).
# TEAM_DOMAIN accepts `burmy`, `burmy.cloudflareaccess.com`, or the full URL.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# ── Cloudflare Tunnel (Milestone 10) ─────────────────────────────────────────
TUNNEL_TOKEN=

# ── Backups (Milestone 10) ───────────────────────────────────────────────────
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=

# ── AI (NOT used in V1) ──────────────────────────────────────────────────────
# Burmy must remain fully functional with no key present — that is verified by
# running the entire test suite without one.
OPENAI_API_KEY=
